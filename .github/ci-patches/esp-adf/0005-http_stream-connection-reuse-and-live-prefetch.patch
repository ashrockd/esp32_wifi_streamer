+esp_err_t http_stream_playlist_insert_tracks(audio_element_handle_t el, char *const *uris, int count)
+{
+    http_stream_t *http = (http_stream_t *)audio_element_getdata(el);
+    if (!http->enable_playlist_parser || !http->playlist) {
+        return ESP_ERR_INVALID_STATE;
+    }
+    if (http->playlist_lock) xSemaphoreTake(http->playlist_lock, portMAX_DELAY);
+    for (int i = 0; i < count; i++) {
+        if (uris[i]) {
+            http_playlist_insert(http->playlist, uris[i]); /* dedups internally */
+        }
+    }
+    if (http->playlist_lock) xSemaphoreGive(http->playlist_lock);
+    return ESP_OK;
+}
