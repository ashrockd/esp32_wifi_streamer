+esp_err_t http_stream_get_tracks_remaining(audio_element_handle_t el, int *remaining)
+{
+    http_stream_t *http = (http_stream_t *)audio_element_getdata(el);
+    if (!http->enable_playlist_parser || !http->playlist || !http->is_playlist_resolved) {
+        return ESP_ERR_INVALID_STATE;
+    }
+    if (!http->playlist->is_incomplete) {
+        return ESP_ERR_NOT_SUPPORTED; /* VOD - nothing live to run out of */
+    }
+    if (http->playlist_lock) xSemaphoreTake(http->playlist_lock, portMAX_DELAY);
+    *remaining = http_playlist_count_remaining(http->playlist);
+    if (http->playlist_lock) xSemaphoreGive(http->playlist_lock);
+    return ESP_OK;
+}
