# ESP32-S3-WROOM-1 N16R8: Wi-Fi/streaming half of the two-chip split. 16MB
# flash, 8MB octal PSRAM. No Bluetooth stack at all on this chip - see
# ../esp32_bt_speaker for that half, connected over I2S (see RADIO_I2S_*_GPIO
# in main/app_config.h - pin numbers changed for this chip, re-read that
# comment before wiring).
#
# 2026-08-22: migrated from an ESP32-WROOM-32U (4MB flash, no PSRAM).

# 2026-09-01: the target is PINNED here as well as being passed to
# `idf.py set-target esp32s3`. It used to be set only by that command, on the
# reasoning that a target cannot be selected from within sdkconfig - which is
# true for SWITCHING targets, but not for the default used when sdkconfig is
# regenerated from scratch. That gap bit: build.ps1 deletes sdkconfig on every
# run, and when its set-target died partway (a stale idf_monitor holding
# build/log open - see the serial-port notes), the next plain `idf.py build`
# regenerated sdkconfig with NO target information and silently fell back to
# IDF's default, esp32. It built cleanly and completely - for the wrong chip,
# with the S3-only PSRAM options above quietly dropped as "unknown kconfig
# symbol". The only visible symptom was `--chip esp32` in the flash hint at
# the very end. Pinning it here makes that failure impossible rather than
# merely unlikely.
CONFIG_IDF_TARGET="esp32s3"

# Real hardware: 16MB flash, 8MB octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# N16R8 = octal SPI PSRAM (the "R8" die needs all 8 data lines - a plain
# quad-PSRAM module would just be CONFIG_SPIRAM_MODE_QUAD here instead).
# Speed left at the safe 80MHz default rather than reaching for octal's
# faster DDR modes sight-unseen on hardware not in hand yet.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Makes plain malloc()/calloc() (not just ESP-ADF's own audio_calloc(), see
# main/app_config.h's file-header comment) spill to PSRAM above IDF's usual
# size threshold - this is what lets mbedTLS's 16KB TLS record buffer and
# esp_aac_dec_open()'s ~51KB internal allocation (both plain malloc callers,
# both closed-source, both named in this project's whole OOM history) land in
# the 8MB pool instead of competing for internal DRAM.
CONFIG_SPIRAM_USE_MALLOC=y
# Lets FreeRTOS task stacks live in PSRAM too - radio_task's 16KB stack
# (main.c) no longer has to come out of internal DRAM.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# ESP-ADF's audio_board component defaults to "ESP32-Lyrat V4.3" - a
# reference dev board this project has never used (no codec/amp chip, no
# board_pins_config.c - radio_pipeline.c configures I2S directly from
# app_config.h's own pins). That default is also classic-ESP32-only: its
# board_pins_config.c hardcodes GPIO_NUM_22/23/25, which don't exist in the
# ESP32-S3's gpio_num_t and fail the build.
#
# Tried CONFIG_AUDIO_BOARD_CUSTOM=y first (compiles audio_board to nothing,
# which is really what this project wants - it uses none of ADF's board
# abstraction). That does NOT work: esp_peripherals is a hard PRIV_REQUIRES
# of audio_board regardless of which board is chosen (see audio_board's
# CMakeLists.txt - that REQUIRES line isn't inside any per-board `if`), and
# esp_peripherals compiles ALL of its periph_*.c files unconditionally, not
# just ones for hardware a board actually has. Several of them (e.g.
# periph_lcd.c) unconditionally `#include "board.h"`, which only exists
# inside a real board's own subdirectory - "custom" provides none, so the
# build fails with "board.h: No such file or directory" before it ever gets
# to our own code.
#
# So a real board has to be selected - just one whose board.h/
# board_pins_config.c actually compile for this chip. Tried ESP32-S3-Korvo-2
# v3 first (2026-08-22) - it looked ideal (native S3 board, pins expressed as
# I2C GPIO-expander bits rather than raw GPIO_NUM_*) but its board.c
# #include "esp_lcd_ili9341.h", an external managed component that ESP-ADF's
# own audio_board/CMakeLists.txt never lists in PRIV_REQUIRES (a gap in that
# vendored file - see build.ps1's build log from 2026-08-31 for the exact
# ninja error). ESP-IDF's component manager can fetch the package fine from a
# project-level idf_component.yml, but that alone doesn't satisfy the
# per-component REQUIRES ninja enforces - actually fixing it means editing
# esp-adf/components/audio_board/CMakeLists.txt itself, which is shared with
# ../esp32_bt_speaker and not something to patch for one side's build.
#
# Switched (2026-08-31) to M5Stack-AtomS3R instead: also a real ESP32-S3
# board, and its board.c only touches periph_sdcard.h/periph_adc_button.h/
# tca9554.h - all already proven to compile - with zero external managed
# dependencies. Its board_def.h leaves every pin GPIO_NUM_NC (not connected),
# so there's no risk of it coincidentally claiming app_config.h's I2S pins
# either. Same as before: none of its board.c hardware-init code ever
# actually runs - this project never calls audio_board_init() or anything
# else from audio_board/ - it only needs to compile and link.
CONFIG_M5STACK_ATOMS3R_BOARD=y
# CONFIG_ESP32_S3_KORVO2_V3_BOARD is not set
# CONFIG_ESP_LYRAT_V4_3_BOARD is not set

# Optimize for size, not speed - tight flash/IRAM budget on this board.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# WiFi's IRAM speed optimizations aren't worth the IRAM budget here (this is
# what caused the single-chip project's earlier iram0_0_seg overflow).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# mbedTLS per-connection RAM usage. IN_CONTENT_LEN must be >= the largest
# single TLS record any server this chip talks to sends - not just at
# handshake, at any point in the connection. The single-chip project's 8192
# was sized only for opml.radiotime.com's handshake (its cert forces 8192;
# see that project's sdkconfig.defaults for the full mbedtls_ssl_fetch_input
# ()/-0x7100 trace history) - this chip additionally reads large (~550KB)
# CMAF media segment bodies from itsliveradio.apple.com, a different CDN,
# and hit the identical -0x7100 "SSL - Bad input parameters" failure on the
# very first body read of one (confirmed via hardware log: fails right after
# HTTP_STREAM logs total_bytes=551498, every single attempt). Raised to
# 16384 - TLS's own hard per-record maximum - so no server's record size can
# ever exceed this again, rather than re-guessing another host-specific
# number. CONFIG_MBEDTLS_DYNAMIC_BUFFER means this is a ceiling the buffer
# can grow to when actually needed, not a fixed per-session cost.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# 2026-08-20: DYNAMIC_BUFFER deliberately turned OFF on this chip.
#
# It was inherited from the single-chip project, where it was the right call:
# there, classic-BT/Bluedroid churned 4112-byte allocations constantly and
# dynamic buffers let mbedTLS avoid pinning 20KB. This chip runs no Bluetooth
# at all, and the tradeoff inverts:
#
# With dynamic buffers mbedTLS FREES and RE-ALLOCATES the record buffer per
# record. Once esp_aac_dec_open() takes its (measured) 51564-byte bite -
# largest free block 98304 -> 49152 - those repeated ~15KB re-allocations
# start failing partway through a segment:
#     E Dynamic Impl: alloc(15158 bytes) failed
#     E esp-tls-mbedtls: SSL - Memory allocation failed
# and they failed AFTER 76478 bytes had already streamed successfully, which
# is the signature of progressive fragmentation, not of a hard shortage.
#
# Static buffers allocate IN+OUT once when the connection is established and
# hold them for the session: one up-front cost instead of a repeated demand
# for a large contiguous block from an increasingly fragmented heap.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=n

# Logging is intentionally verbose for bring-up.
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# Required by esp_crt_bundle_attach for TuneIn/Apple HTTPS endpoints.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

CONFIG_ESP_TIMER_TASK_STACK_SIZE=8192

# 2026-09-04, TEMPORARY DIAGNOSTIC - two real hardware heap-corruption
# crashes (see [[esp32-wifi-streamer-aac-heap-crash]] project memory / the
# aac_dec_element.c comment on AAC_DEC_PCM_BYTES), both caught downstream of
# where the actual corruption happened: a StoreProhibited fault inside
# tlsf_free()'s block-coalescing on a 20-minute proactive session refresh,
# and (after the first fix shifted heap layout enough to change WHICH
# allocation the same underlying issue lands on) a "block already marked as
# free" assert on a station change. Both are the standard signature of heap
# metadata corruption surfacing far from its actual write - see ESP-IDF's own
# heap-debugging guidance: https://docs.espressif.com/projects/esp-idf/en/latest/esp32/api-reference/system/heap_debug.html
#
# LIGHT (not COMPREHENSIVE): adds head/tail canary bytes to every allocation,
# checked whenever that block is next freed - this reliably catches a buffer
# OVERRUN (writing past the end of an allocation), which is the leading
# hypothesis for both crashes above, at much lower cost than COMPREHENSIVE
# (which additionally re-validates the ENTIRE heap's structure on every
# single malloc/free anywhere in the system - real overhead for a real-time
# audio decode path, not justified until LIGHT proves insufficient).
#
# Combined with main.c's periodic heap_caps_check_integrity_all() call (see
# resource_log_timer_cb) - that call already runs every
# RADIO_RESOURCE_LOG_INTERVAL_MS regardless of this setting, and will now
# also benefit from poisoning's finer-grained per-block canaries when it
# finds something wrong.
#
# TAKE THIS BACK OUT once a fix is confirmed hardware-stable (a long,
# uninterrupted run - past 20 minutes - AND several station changes, with no
# crash and no "CORRUPT HEAP"/canary-check log line) - it has a real, if
# modest, per-allocation cost that has no reason to ship permanently once its
# job here is done.
CONFIG_HEAP_POISONING_DISABLED=n
CONFIG_HEAP_POISONING_LIGHT=y
